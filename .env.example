# =====================================================================
# NORE - Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit your real .env file to version control.
# =====================================================================

# Server Environment
APP_ENV=development
APP_NAME="NORE"
PORT=8000
HOST=0.0.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ElevenLabs Integration (Required for Voice Synthesis)
# Retrieve your key from https://elevenlabs.io/app/settings/api-keys
# Ensure permissions include: text_to_speech, voices_read, models_read, user_read
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_DEFAULT_MODEL_ID=eleven_turbo_v2_5

# Authentication & Security
# Generate a secure 64-char key: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_key_here_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Secret Key (alias for JWT_SECRET_KEY)
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here_for_production

# Initial Owner Credentials (seeded on first startup per Section 9)
OWNER_INITIAL_EMAIL=owner@nore.ai
OWNER_INITIAL_PASSWORD=ChangeThisOwnerPasswordInProduction!123

# Database Configuration
# Development default: SQLite (async)
DATABASE_URL=sqlite+aiosqlite:///./voice_assistant.db
# Production example: PostgreSQL (async)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/voice_assistant

# Optional Redis Cache / Real-time PubSub (falls back to memory if empty)
REDIS_URL=

# Rate Limiting & Usage Quotas
RATE_LIMIT_REQUESTS_PER_MINUTE=120
DEFAULT_DAILY_CHARACTER_QUOTA=50000

# Technology Intelligence Web Search (Optional)
# Default is 'auto' with DuckDuckGo live search + Authoritative Feeds (zero config needed)
TECH_SEARCH_PROVIDER=auto
TECH_SEARCH_MAX_RESULTS=6
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
# TAVILY_API_KEY=your_tavily_api_key_here

